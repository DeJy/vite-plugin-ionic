{
  "name": "vite-plugin-ionic",
  "version": "1.0.3",
  "description": "Vite plugin that integrates @ionic/core — handles static file serving (dev + build), optimizeDeps, externals, and LightningCSS warning suppression.",
  "keywords": [
    "vite",
    "vite-plugin",
    "ionic",
    "ionic-framework",
    "web-components",
    "stencil",
    "react",
    "vue",
    "angular",
    "svelte",
    "mithril"
  ],
  "author": "Dominic Jean <dominic.jean@dejy.info>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/DeJy/vite-plugin-ionic.git"
  },
  "homepage": "https://github.com/DeJy/vite-plugin-ionic#readme",
  "bugs": {
    "url": "https://github.com/DeJy/vite-plugin-ionic/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@ionic/core": ">=7.0.0",
    "vite": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": false
    },
    "@ionic/core": {
      "optional": false
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
